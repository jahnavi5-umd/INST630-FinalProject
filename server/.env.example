# ---- TerpLink server configuration ----
# Copy to server/.env and fill in. NEVER commit .env.

NODE_ENV=development
PORT=5000

# MongoDB connection string (Atlas or local). If left empty in development,
# an embedded store is used automatically and seeded with demo data.
MONGODB_URI=

# Long random secret used to sign session tokens (min 32 chars).
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Google OAuth "Web application" client ID from https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:5173 (dev) and your production URL.
GOOGLE_CLIENT_ID=

# Comma-separated list of browser origins allowed to call the API.
CLIENT_ORIGIN=http://localhost:5173

# Email domain allowed to sign in (subdomains such as terpmail.umd.edu are also allowed).
ALLOWED_EMAIL_DOMAIN=umd.edu

# Set to 1 when running behind a reverse proxy / load balancer (Render, Heroku, Nginx...)
TRUST_PROXY=0
